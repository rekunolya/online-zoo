{
"compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "baseUrl": "."
  },
  "include": ["assets/**/*.ts", "pages/**/*.ts"],
  "exclude": ["node_modules"]
}
